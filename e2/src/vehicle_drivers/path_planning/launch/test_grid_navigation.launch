<?xml version="1.0"?>
<launch>
  <!-- Launch the hybrid A* node -->
  <node pkg="path_planning" type="hybrid_astar_node.py" name="hybrid_astar_node" output="screen">
    <!-- Grid Parameters -->
    <param name="grid_size" value="80.0"/>
    <param name="cell_size" value="0.5"/>
    <param name="center_lat" value="40.0928174"/>
    <param name="center_lon" value="-88.2356714"/>
    <param name="smoothing" value="0.3"/>
    <param name="frame_id" value="map"/>
  </node>

  <!-- Launch the test script -->
  <node pkg="path_planning" type="test_grid_navigation.py" name="test_grid_navigation" output="screen"/>
</launch> 